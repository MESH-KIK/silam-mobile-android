<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 1. PERBAIKAN: Tambahkan Izin Internet di sini (di luar tag <application>) -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.SILAM"> <!-- 2. PERBAIKAN: Ditambahkan usesCleartextTraffic="true" -->

        <!-- 1. Splash Screen sebagai Launcher Utama -->
        <activity
            android:name=".activity.SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 2. Landing Page (Tujuan setelah Splash Screen) -->
        <activity
            android:name=".activity.LandingPageActivity"
            android:exported="false" />

        <!-- 3. Activity Lainnya -->
        <activity
            android:name=".activity.CekStatusPelangganActivity"
            android:exported="false" />

        <activity
            android:name=".activity.LoginPegawaiActivity"
            android:exported="false" />

        <activity
            android:name=".activity.DashboardPegawaiActivity"
            android:exported="false" />

        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <!-- Meta Data Font Preload -->
        <meta-data
            android:name="preloaded_fonts"
            android:resource="@array/preloaded_fonts" />

    </application>

</manifest>