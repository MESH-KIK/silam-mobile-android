<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAF8F5"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Top Header Info -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_marginTop="60dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/imgLogoSilam"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:contentDescription="SILAM Logo"
                    android:src="@drawable/silam_logo" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_bold"
                            android:text="SILAM"
                            android:textColor="#2D2D2D"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:background="#D3E0FA"
                            android:fontFamily="@font/inter_bold"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="2dp"
                            android:text="Shift Pagi"
                            android:textColor="#2E4A85"
                            android:textSize="9sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter"
                        android:text="Cabang Sukajadi"
                        android:textColor="#64748B"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>
        </RelativeLayout>

        <!-- Title Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_bold"
                android:text="Antrian &amp; Alur Kerja"
                android:textColor="#2D2D2D"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSubJudul"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/inter"
                android:text="Memuat data..."
                android:textColor="#64748B"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Input Box Pencarian -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="14dp"
            app:cardElevation="1dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingHorizontal="14dp">

                <ImageView
                    android:id="@+id/imgIconSearch"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:contentDescription="Cari"
                    android:src="@android:drawable/ic_menu_search"
                    app:tint="#2E4A85" />

                <EditText
                    android:id="@+id/etCariAntrian"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="10dp"
                    android:layout_toEndOf="@id/imgIconSearch"
                    android:background="@null"
                    android:fontFamily="@font/inter"
                    android:hint="Cari nama atau nomor nota"
                    android:inputType="text"
                    android:textColor="#2D2D2D"
                    android:textColorHint="#94A3B8"
                    android:textSize="12sp" />
            </RelativeLayout>
        </androidx.cardview.widget.CardView>

        <!-- Filter Chips -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chipSemua"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#2E4A85"
                    android:fontFamily="@font/inter_bold"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    android:text="Semua  0"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/chipAntrian"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="#D3E0FA"
                    android:fontFamily="@font/inter_medium"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    android:text="Perlu Dicuci  0"
                    android:textColor="#2E4A85"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/chipProses"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="#D3E0FA"
                    android:fontFamily="@font/inter_medium"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    android:text="Diproses  0"
                    android:textColor="#2E4A85"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/chipSiap"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="#D3E0FA"
                    android:fontFamily="@font/inter_medium"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    android:text="Siap Diambil  0"
                    android:textColor="#2E4A85"
                    android:textSize="11sp" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Daftar pesanan: diisi otomatis dari API -->
        <LinearLayout
            android:id="@+id/llDaftar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/tvKosong"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="@font/inter"
            android:gravity="center"
            android:text="Memuat data..."
            android:textColor="#64748B"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>